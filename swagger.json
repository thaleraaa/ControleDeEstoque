{
    "openapi": "3.0.0",
    "info": {
        "title": "API Controle de Estoque",
        "description": "Essa API tem como objetivo facilitar o controle de estoque da sua empresa",
        "temOfService": "http://localhost:3333/terms",
        "contatc": {
            "email": "yourEmail@outlook.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/v1/user": {
            "post": {
                "description": "Criar Usuario",
                "requestBody": {
                    "description": "Dados necessarios para criação de um novo usuario",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RequestCreateUser"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref":"#/components/schemas/ResponseCreateUser"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RequestCreateUser": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "ResponseCreateUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                }
            }  
        },

        "securityShemes": {}
    }
}